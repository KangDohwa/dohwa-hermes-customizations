+def _tavily_error_response(exc: Exception, *, operation: str) -> Dict[str, Any]:
+    """Classify Tavily failures without relying on error-string matching."""
+    import httpx
+
+    error_code = "provider_error"
+    retryable = False
+    if isinstance(exc, httpx.HTTPStatusError):
+        status = exc.response.status_code
+        if status in {401, 403}:
+            error_code = "authentication_failed"
+        elif status == 429:
+            error_code, retryable = "rate_limited", True
+        elif 500 <= status < 600:
+            error_code, retryable = "provider_unavailable", True
+        else:
+            error_code = "http_error"
+    elif isinstance(exc, httpx.TimeoutException):
+        error_code, retryable = "timeout", True
+    elif isinstance(exc, httpx.NetworkError):
+        error_code, retryable = "network_error", True
+    elif isinstance(exc, ValueError):
+        error_code = "configuration_error"
+
+    return {
+        "success": False,
+        "error": f"Tavily {operation} failed: {exc}",
+        "error_code": error_code,
+        "retryable": retryable,
+    }
+
